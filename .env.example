# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# "anthropic" (Claude tool-calling) or "sarvam" (Sarvam AI, OpenAI-compatible
# chat-completions API). Empty LLM_API_KEY always falls back to the
# zero-dependency rule-based client regardless of which provider is set.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
# Only used when LLM_PROVIDER=sarvam — Sarvam's API base URL.
LLM_BASE_URL=https://api.sarvam.ai/v1

# --- Voice provider ---
# "mock" runs the agent as a local text chat loop (no phone call, no vendor needed).
# "vapi" places/receives real calls via the Vapi platform.
VOICE_PROVIDER=mock
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Phone number or SIP URI a live call is warm-transferred to on escalation.
HUMAN_TRANSFER_DESTINATION=

# Public URL Vapi (or any external webhook caller) can reach this backend on.
# In dev this is your ngrok URL, e.g. https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8000
